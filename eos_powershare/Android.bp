cc_binary {
    name: "vendor.expressiveos.powershare-service.default",
    vintf_fragments: ["vendor.expressiveos.powershare-service.default.xml"],
    init_rc: ["vendor.expressiveos.powershare-service.default.rc"],
    relative_install_path: "hw",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
    ] + select(soong_config_variable("eos_powershare", "powershare_path"), {
        any @ flag_val: ["-DPOWERSHARE_PATH=\"" + flag_val + "\""],
        default: ["-DPOWERSHARE_PATH=\"/sys/class/power_supply/wireless/device/rtx\""],
    }) + select(soong_config_variable("eos_powershare", "powershare_enabled"), {
        any @ flag_val: ["-DPOWERSHARE_ENABLED=\"" + flag_val + "\""],
        default: ["-DPOWERSHARE_ENABLED=\"1\""],
    }) + select(soong_config_variable("eos_powershare", "powershare_disabled"), {
        any @ flag_val: ["-DPOWERSHARE_DISABLED=\"" + flag_val + "\""],
        default: ["-DPOWERSHARE_DISABLED=\"0\""],
    }),
    srcs: [
        "PowerShare.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.expressiveos.powershare-V1-ndk",
    ],
}
